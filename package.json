{
  "name": "basix-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "db:generate": "pnpm --filter @basix-core/database db:generate",
    "db:migrate": "pnpm --filter @basix-core/database db:migrate",
    "db:reset": "pnpm --filter @basix-core/database db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:vault:build": "docker compose build vault-postgres",
    "docker:vault:up": "docker compose up -d vault-postgres",
    "docker:vault:logs": "docker compose logs -f vault-postgres",
    "docker:vault:psql": "docker compose exec vault-postgres psql -U postgres -d basix_vault",
    "docker:vault:smoke": "docker compose exec vault-postgres psql -U postgres -d basix_vault -c \"SELECT extname FROM pg_extension WHERE extname IN ('pgsodium', 'supabase_vault');\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.7",
    "dotenv-cli": "^11.0.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
