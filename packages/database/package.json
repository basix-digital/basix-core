{
  "name": "@basix-core/database",
  "version": "0.3.3",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:studio": "prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "test": "pnpm db:generate && tsc -p tsconfig.test.json && node --test \".test-build/**/*.spec.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
