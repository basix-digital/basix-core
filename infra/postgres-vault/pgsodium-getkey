#!/usr/bin/env bash
set -euo pipefail

key_file="${PGSODIUM_KEY_FILE:-/var/lib/postgresql/pgsodium/pgsodium.key}"
key_dir="$(dirname "$key_file")"

mkdir -p "$key_dir"
chmod 0700 "$key_dir" 2>/dev/null || true

if [ ! -f "$key_file" ]; then
  umask 077
  openssl rand -hex 32 > "$key_file"
  chmod 0600 "$key_file" 2>/dev/null || true
fi

cat "$key_file"
