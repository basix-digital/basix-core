# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/basix_core"

# Redis
REDIS_URL="redis://localhost:6379"

# Admin Auth
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
API_TOKEN_LAST_USED_TOUCH_INTERVAL_MS="300000"
OBSERVABILITY_HASH_SECRET="change-me-observability"

# Internal Services
INTERNAL_SERVICE_SECRET="change-me-internal"
VAULT_DATABASE_URL="postgresql://basix_vault_app:basix_vault_app@localhost:5433/basix_vault"
PROVIDER_CREDENTIALS_FALLBACK_ENV="true"
AI_AGENT_SECRET_KEY="change-me-32-byte-secret"
AI_AGENT_LLM_PROVIDER="openrouter"
AI_AGENT_DEFAULT_MODEL="openai/gpt-4.1-mini"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_HTTP_REFERER="http://localhost:3001"
OPENROUTER_APP_TITLE="Basix Core"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="Basix Core"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""

# Environment
NODE_ENV="development"
PORT="3000"
